terraform {
  required_providers {
    aws = {
      source = "hashicorp/aws"
      version = "= 5.100.0"
    }
  }
}
provider "aws" {
  region = "us-east-1"
  access_key = "offline-fixture"
  secret_key = "offline-fixture"
  skip_credentials_validation = true
  skip_requesting_account_id = true
  skip_metadata_api_check = true
  skip_region_validation = true
}
locals {
  enabled                             = true
  aws_account_number                  = "111122223333"
  eks_cluster_oidc_issuer              = "example.invalid"
  service_account_namespace_name_list = ["default:example"]
}
data "aws_iam_policy_document" "service_account_assume_role" {
  count = local.enabled ? 1 : 0

  statement {
    actions = [
      "sts:AssumeRoleWithWebIdentity"
    ]

    effect = "Allow"

    principals {
      type        = "Federated"
      identifiers = [format("arn:%s:iam::%s:oidc-provider/%s", "aws", local.aws_account_number, local.eks_cluster_oidc_issuer)]
    }

    condition {
      test     = "StringLike"
      values   = formatlist("system:serviceaccount:%s", local.service_account_namespace_name_list)
      variable = format("%s:sub", local.eks_cluster_oidc_issuer)

    }
    condition {
      test     = "StringEquals"
      values   = ["sts.amazonaws.com"]
      variable = format("%s:aud", local.eks_cluster_oidc_issuer)
    }
  }

  lifecycle {
    precondition {
      condition     = length(local.eks_cluster_oidc_issuer) > 0
      error_message = "The eks_cluster_oidc_issuer_url value must have a value."
    }
  }
}
output "principal_matches" {
  value = try(jsondecode(data.aws_iam_policy_document.service_account_assume_role[0].json).Statement[0].Principal.Federated == "arn:aws:iam::111122223333:oidc-provider/example.invalid", false)
}
